DATABASE_URL="postgresql://postgres:plotguard@localhost:55432/plotguard?schema=public"
AUTH_TOKEN_SECRET="replace-with-a-long-random-secret"
# Powers document OCR and the citizen assistant. The assistant can fall back
# to a placeholder, but OCR fails closed when unset so a mutation cannot pass
# on fabricated extraction data.
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.6-flash
