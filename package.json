{
  "name": "plotguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @plotguard/rules build && next dev",
    "build": "pnpm --filter @plotguard/rules build && next build",
    "start": "next start",
